{
  "name": "pokemon-evolution",
  "version": "1.0.0",
  "description": "Interactive GitHub contribution-powered Pokémon evolution companion in 2.5D modern anime aesthetic",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "node scripts/server.js",
    "start": "node scripts/server.js",
    "preview": "node scripts/server.js",
    "cli": "node src/cli.js --mode=offline",
    "build": "node scripts/build.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "octokit": "^4.1.2",
    "pngjs": "^7.0.0",
    "sharp": "^0.33.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "prettier": "^3.5.2",
    "vitest": "^3.0.7"
  }
}